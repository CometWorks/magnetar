<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Product>Magnetar</Product>
    <Copyright>© 2026 SpaceGT</Copyright>
    <AssemblyTitle>Magnetar</AssemblyTitle>
    <Description>Plugin and Mod loader for the Space Engineers 1 Dedicated Server</Description>
  </PropertyGroup>
  <PropertyGroup>
    <RootNamespace>Magnetar.Legacy</RootNamespace>
    <PackageId>Magnetar</PackageId>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- Windows builds both the .NET Framework (MagnetarLegacy) and .NET 10
         (MagnetarInterim) launchers. Linux can only build the .NET 10 launcher
         (net48 needs the Windows .NET Framework reference assemblies). -->
    <TargetFrameworks Condition="'$(OS)' == 'Windows_NT'">net48;net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(OS)' != 'Windows_NT'">net10.0</TargetFrameworks>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
  </PropertyGroup>
  <PropertyGroup>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
    <AssemblyName>MagnetarLegacy</AssemblyName>
    <!-- Binding redirects are deliberately off (above): Magnetar is the host
         process itself — it loads the Space Engineers DS assemblies and runs the
         server inside its own process, so this app's config governs assembly
         resolution for the game. Auto-generated redirects to newer transitive
         versions (Roslyn, System.*) would then shadow the versions the game
         expects and could break it. The resulting MSB3276 conflict warning is
         therefore expected noise here. -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3276</MSBuildWarningsAsMessages>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' != 'net48'">
    <AssemblyName>MagnetarInterim</AssemblyName>
  </PropertyGroup>
  <!-- Windows-only launcher polish: the .ico is embedded in the apphost.
       It does not apply on Linux. -->
  <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Required by SpaceEngineers internally; Deserialization is patched to use safer methods. -->
    <EnableUnsafeBinaryFormatterSerialization>true</EnableUnsafeBinaryFormatterSerialization>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Defined before StartProgram: MSBuild evaluates properties top-down. -->
    <_MagnetarExeExt Condition="'$(OS)' == 'Windows_NT'">.exe</_MagnetarExeExt>
    <_MagnetarExeExt Condition="'$(OS)' != 'Windows_NT'">.bin</_MagnetarExeExt>
    <StartAction>Program</StartAction>
    <StartProgram>$(Magnetar)/$(AssemblyName)$(_MagnetarExeExt)</StartProgram>
    <StartWorkingDirectory>$(Magnetar)</StartWorkingDirectory>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\PluginSdk\PluginSdk.csproj" />
    <!-- Pulsar submodule projects use Pulsar's own Directory.Build.props;
         forward the values they need explicitly. -->
    <!-- $(Steamworks) holds Steamworks.NET.dll (referenced by Shared) and the
         platform's steam_api native library; SteamApiFileName names the
         latter. Both are forwarded so the submodule sees the same values this
         project's Verify and Deploy targets check against. -->
    <ProjectReference Include="..\Pulsar\Shared\Shared.csproj"
                      AdditionalProperties="Steamworks=$(Steamworks);SteamApiFileName=$(SteamApiFileName)" />
    <!-- The out-of-process Roslyn compiler. Not referenced as an assembly: its
         own Deploy target stages the executable and its dependencies into
         $(Magnetar)/Libraries/Compiler (the 'Pulsar' property is its
         deployment root). -->
    <ProjectReference Include="..\Pulsar\Compiler\Compiler.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true"
                      AdditionalProperties="Pulsar=$(Magnetar);Steamworks=$(Steamworks)" />
  </ItemGroup>
  <!-- The Linux native-library bootstrap pulls in System.Runtime.Loader /
       OperatingSystem.IsLinux, which do not exist on .NET Framework. It is only
       reached from Main() under #if NETCOREAPP, so exclude it from the net48 build. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Compile Remove="Loader\NativeLibraryPreloader.cs" />
  </ItemGroup>
  <!-- Compiled from the submodule source (not copied) so upstream fixes are
       picked up automatically on a submodule bump. To make this possible, all
       code derived from Pulsar/Legacy keeps its upstream Pulsar.Legacy.*
       namespaces (Magnetar-original code lives in Magnetar.Legacy.*), so the
       linked files resolve the forked parts of their dependency closure
       (LoaderTools, PluginLoader, SteamMods, Game, Folder, the Patch_* forks)
       without any source edit. A file can be linked here whenever it needs no
       server-specific changes; otherwise it stays a fork under Legacy/. -->
  <ItemGroup>
    <Compile Include="..\Pulsar\Legacy\Loader\PluginInstance.cs" Link="Loader\PluginInstance.cs" />
    <Compile Include="..\Pulsar\Legacy\Patch\Patch_ComponentRegistered.cs" Link="Patch\Patch_ComponentRegistered.cs" />
    <Compile Include="..\Pulsar\Legacy\Patch\Patch_LoadScripts.cs" Link="Patch\Patch_LoadScripts.cs" />
    <Compile Include="..\Pulsar\Legacy\Patch\Patch_PrepareCrashReport.cs" Link="Patch\Patch_PrepareCrashReport.cs" />
    <Compile Include="..\Pulsar\Legacy\Patch\Patch_Rewriter.cs" Link="Patch\Patch_Rewriter.cs" />
    <Compile Include="..\Pulsar\Legacy\Patch\Patch_StableLogs.cs" Link="Patch\Patch_StableLogs.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Microsoft.CodeAnalysis" HintPath="$(DS64)\Microsoft.CodeAnalysis.dll" Private="False" />
    <Reference Include="Microsoft.CodeAnalysis.CSharp" HintPath="$(DS64)\Microsoft.CodeAnalysis.CSharp.dll" Private="False" />
    <Reference Include="Sandbox.Game" HintPath="$(DS64)\Sandbox.Game.dll" Private="False" />
    <Reference Include="Sandbox.Common" HintPath="$(DS64)\Sandbox.Common.dll" Private="False" />
    <Reference Include="Sandbox.Graphics" HintPath="$(DS64)\Sandbox.Graphics.dll" Private="False" />
    <Reference Include="SpaceEngineersDedicated" HintPath="$(DS64)\SpaceEngineersDedicated.exe" Private="False" />
    <Reference Include="SpaceEngineers.Game" HintPath="$(DS64)\SpaceEngineers.Game.dll" Private="False" />
    <Reference Include="VRage" HintPath="$(DS64)\VRage.dll" Private="False" />
    <Reference Include="VRage.Dedicated" HintPath="$(DS64)\VRage.Dedicated.dll" Private="False" />
    <Reference Include="VRage.Game" HintPath="$(DS64)\VRage.Game.dll" Private="False" />
    <Reference Include="VRage.Input" HintPath="$(DS64)\VRage.Input.dll" Private="False" />
    <Reference Include="VRage.Library" HintPath="$(DS64)\VRage.Library.dll" Private="False" />
    <Reference Include="VRage.Math" HintPath="$(DS64)\VRage.Math.dll" Private="False" />
    <Reference Include="VRage.Scripting" HintPath="$(DS64)\VRage.Scripting.dll" Private="False" />
  </ItemGroup>
  <!-- VRage.Platform.Windows is a Windows-only platform assembly shipped with the
       Windows dedicated server; the Linux server replaces it with its own. -->
  <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
    <Reference Include="VRage.Platform.Windows" HintPath="$(DS64)\VRage.Platform.Windows.dll" Private="False" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.4.2" />
    <PackageReference Include="Gameloop.Vdf" Version="0.6.2" />
  </ItemGroup>
  <Target Name="Verify" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(Magnetar)' == ''" Text="Specify Magnetar's deployment location!" />
    <Error Condition="$(Magnetar.Contains(';'))" Text="Magnetar directory is not unique!" />
    <Error Condition="'$(DS64)' == '' or !Exists('$(DS64)')" Text="Specify the SpaceEngineers DedicatedServer64 path (DS64)!" />
    <Error Condition="'$(Steamworks)' == ''" Text="Specify the Steamworks path!" />
    <Error Condition="!Exists('$(Steamworks)/Steamworks.NET.dll')" Text="Steamworks.NET.dll not found in $(Steamworks)!" />
    <Error Condition="'$(OS)' != 'Windows_NT' and !Exists('$(Steamworks)/$(SteamApiFileName)')"
           Text="$(SteamApiFileName) not found in $(Steamworks)! The dedicated server depot ships only the Windows steam_api64.dll, so on Linux point the Steamworks property at an extracted steam-dependencies.tar.gz from github.com/CometWorks/linux-dependencies." />
  </Target>
  <!-- Deploy the freshly built launcher and its libraries into the Magnetar
       install folder, mirroring Pulsar's deployment convention:
         $(Magnetar)/MagnetarLegacy.exe | MagnetarInterim.exe|.bin
         $(Magnetar)/Libraries/<AssemblyName>/  managed + native dependencies
         $(Magnetar)/Libraries/Compiler/        staged by Pulsar's Compiler project
       The '$(TargetFramework)' != '' guard restricts this to the per-TFM inner
       builds of this multi-targeting project (the outer build has no OutDir). -->
  <Target Name="Deploy" AfterTargets="Build" Condition="'$(TargetFramework)' != ''">
    <PropertyGroup>
      <DeployDirectory>$(Magnetar)/Libraries/$(AssemblyName)</DeployDirectory>
      <LicensePath>$(MSBuildProjectDirectory)/../LICENSE</LicensePath>
      <ReadmePath>$(MSBuildProjectDirectory)/../README.md</ReadmePath>
      <SourceExecutable>$(TargetDir)$(AssemblyName)$(_NativeExecutableExtension)</SourceExecutable>
      <DestinationExecutable>$(Magnetar)/$(AssemblyName)$(_MagnetarExeExt)</DestinationExecutable>
    </PropertyGroup>
    <ItemGroup>
      <DeployLibraryFile Include="$(TargetDir)Pulsar.Shared.dll" />
      <DeployLibraryFile Include="$(TargetDir)Pulsar.Protocol.dll" />
      <DeployLibraryFile Include="$(TargetDir)PluginSdk.dll" />
      <DeployLibraryFile Include="$(TargetDir)0Harmony.dll" />
      <DeployLibraryFile Include="$(TargetDir)Mono.Cecil.dll" />
      <DeployLibraryFile Include="$(TargetDir)Mono.Cecil.Mdb.dll" Condition="Exists('$(TargetDir)Mono.Cecil.Mdb.dll')" />
      <DeployLibraryFile Include="$(TargetDir)Mono.Cecil.Pdb.dll" Condition="Exists('$(TargetDir)Mono.Cecil.Pdb.dll')" />
      <DeployLibraryFile Include="$(TargetDir)Mono.Cecil.Rocks.dll" Condition="Exists('$(TargetDir)Mono.Cecil.Rocks.dll')" />
      <DeployLibraryFile Include="$(TargetDir)Newtonsoft.Json.dll" />
      <DeployLibraryFile Include="$(TargetDir)Gameloop.Vdf.dll" />
      <DeployLibraryFile Include="$(TargetDir)NLog.dll" />
      <DeployLibraryFile Include="$(TargetDir)protobuf-net.dll" />
      <DeployLibraryFile Include="$(TargetDir)SharpCompress.dll" />
      <DeployLibraryFile Include="$(TargetDir)McMaster.Extensions.CommandLineUtils.dll" />
      <DeployLibraryFile Include="$(TargetDir)FuzzySharp.dll" />
      <DeployLibraryFile Include="$(TargetDir)System.Text.Json.dll" Condition="Exists('$(TargetDir)System.Text.Json.dll')" />
      <DeployLibraryFile Include="$(TargetDir)NuGet.Commands.dll" />
      <DeployLibraryFile Include="$(TargetDir)NuGet.Common.dll" />
      <DeployLibraryFile Include="$(TargetDir)NuGet.Configuration.dll" />
      <DeployLibraryFile Include="$(TargetDir)NuGet.DependencyResolver.Core.dll" />
      <DeployLibraryFile Include="$(TargetDir)NuGet.Frameworks.dll" />
      <DeployLibraryFile Include="$(TargetDir)NuGet.LibraryModel.dll" />
      <DeployLibraryFile Include="$(TargetDir)NuGet.Packaging.dll" />
      <DeployLibraryFile Include="$(TargetDir)NuGet.ProjectModel.dll" />
      <DeployLibraryFile Include="$(TargetDir)NuGet.Protocol.dll" />
      <DeployLibraryFile Include="$(TargetDir)NuGet.Versioning.dll" />
      <DeployLibraryFile Include="$(TargetDir)NuGet.Credentials.dll" Condition="Exists('$(TargetDir)NuGet.Credentials.dll')" />
      <DeployLibraryFile Include="$(TargetDir)Microsoft.Extensions.FileProviders.Abstractions.dll" Condition="Exists('$(TargetDir)Microsoft.Extensions.FileProviders.Abstractions.dll')" />
      <DeployLibraryFile Include="$(TargetDir)Microsoft.Extensions.FileSystemGlobbing.dll" Condition="Exists('$(TargetDir)Microsoft.Extensions.FileSystemGlobbing.dll')" />
      <DeployLibraryFile Include="$(TargetDir)Microsoft.Extensions.Primitives.dll" Condition="Exists('$(TargetDir)Microsoft.Extensions.Primitives.dll')" />
      <DeployLibraryFile Include="$(TargetDir)System.ServiceModel.dll" Condition="Exists('$(TargetDir)System.ServiceModel.dll')" />
      <DeployLibraryFile Include="$(TargetDir)System.ServiceModel.Primitives.dll" Condition="Exists('$(TargetDir)System.ServiceModel.Primitives.dll')" />
      <!-- Needed by NuGet signature verification on .NET Core (in the GAC on Framework). -->
      <DeployLibraryFile Include="$(TargetDir)System.Security.Cryptography.Pkcs.dll" Condition="Exists('$(TargetDir)System.Security.Cryptography.Pkcs.dll')" />
      <DeployLibraryFile Include="$(TargetDir)System.Security.Cryptography.ProtectedData.dll" Condition="Exists('$(TargetDir)System.Security.Cryptography.ProtectedData.dll')" />
    </ItemGroup>
    <!-- On Windows the Steam files are deliberately NOT bundled: the dedicated
         server ships Steamworks.NET.dll and steam_api64.dll next to itself and
         both resolve from there, so a DS update can never be paired with a
         stale bundled copy.

         Linux gets no such luck. The depot carries only the Windows
         steam_api64.dll, which the native loader cannot use, so nothing on the
         probe path satisfies Steamworks.NET's steam_api64 P/Invoke and the
         server dies in MySteamGameServer.Start. The DS's Steamworks.NET.dll
         also predates the overloads linux-compat's preloader rewrites
         SetItemTags and GetNumSubscribedItems onto. Both therefore come from
         $(Steamworks), which on Linux points at an extracted
         steam-dependencies.tar.gz rather than at the DS (see
         Directory.Build.props). linux-compat's own assets do not cover these
         two; they carry EOS, Havok, RecastDetour and VRageNative, which is why
         only the Steam pair is staged here.

         The NativeLibraryPreloader still dlopens any lib*.so* an operator
         drops into the deploy folder, so a manual copy keeps overriding
         whatever a build stages. -->
    <ItemGroup Condition="'$(OS)' != 'Windows_NT'">
      <DeployLibraryFile Include="$(Steamworks)/Steamworks.NET.dll" />
      <DeployLibraryFile Include="$(Steamworks)/$(SteamApiFileName)" />
      <!-- Attribution travels with the binaries it covers. steam-dependencies
           ships these next to them; a $(Steamworks) folder assembled by hand
           may not, hence the Exists guards. -->
      <DeployLicenseFile Include="$(Steamworks)/LICENSES/Steamworks.NET-LICENSE.txt"
                         Condition="Exists('$(Steamworks)/LICENSES/Steamworks.NET-LICENSE.txt')" />
      <DeployLicenseFile Include="$(Steamworks)/LICENSES/Steam-NOTICE.txt"
                         Condition="Exists('$(Steamworks)/LICENSES/Steam-NOTICE.txt')" />
    </ItemGroup>
    <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
      <DeployRootFile Include="$(TargetDir)$(AssemblyName).exe.config" />
      <DeployLibraryFile Include="$(TargetDir)Microsoft.Win32.Registry.dll" />
      <DeployLibraryFile Include="$(TargetDir)Microsoft.Bcl.AsyncInterfaces.dll" />
      <DeployLibraryFile Include="$(TargetDir)System.Buffers.dll" />
      <DeployLibraryFile Include="$(TargetDir)System.Memory.dll" />
      <DeployLibraryFile Include="$(TargetDir)System.Numerics.Vectors.dll" />
      <DeployLibraryFile Include="$(TargetDir)System.Runtime.CompilerServices.Unsafe.dll" />
      <DeployLibraryFile Include="$(TargetDir)System.Threading.Tasks.Extensions.dll" />
    </ItemGroup>
    <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETCoreApp'">
      <DeployRootFile Include="$(TargetDir)$(AssemblyName).dll" />
      <DeployRootFile Include="$(TargetDir)$(AssemblyName).runtimeconfig.json" />
      <DeployRootFile Include="$(TargetDir)$(AssemblyName).deps.json" />
    </ItemGroup>
    <!-- Safety net: the DeployLibraryFile list is maintained by hand (mirroring
         Pulsar's convention), so warn when the build output contains a
         copy-local dependency the list does not stage — typically after a
         Pulsar submodule bump added or renamed a package. -->
    <ItemGroup>
      <_DeployedName Include="@(DeployLibraryFile->'%(Filename)%(Extension)')" />
      <!-- Skip satellite/RID-specific assets (they carry a destination
           subdirectory and are not loaded from the flat Libraries folder). -->
      <_CopyLocalName
          Include="@(ReferenceCopyLocalPaths->'%(Filename)%(Extension)')"
          Condition="'%(Extension)' == '.dll' and '%(ReferenceCopyLocalPaths.DestinationSubDirectory)' == '' and !$([System.String]::new('%(Filename)').EndsWith('.resources'))" />
      <_UnstagedDependency Include="@(_CopyLocalName)" Exclude="@(_DeployedName)" />
    </ItemGroup>
    <Warning Condition="'@(_UnstagedDependency)' != ''"
             Text="Dependencies in the build output but not staged by Deploy: @(_UnstagedDependency). Add them to DeployLibraryFile (did a Pulsar submodule bump add a package?)." />
    <Error Condition="!Exists('$(LicensePath)')" Text="License file not found!" />
    <Error Condition="!Exists('$(ReadmePath)')" Text="Readme file not found!" />
    <RemoveDir Directories="$(DeployDirectory)" />
    <Copy SourceFiles="@(DeployRootFile)" DestinationFolder="$(Magnetar)" />
    <Copy SourceFiles="@(DeployLibraryFile)" DestinationFolder="$(DeployDirectory)" />
    <Copy SourceFiles="@(DeployLicenseFile)" DestinationFolder="$(DeployDirectory)/LICENSES"
          Condition="'@(DeployLicenseFile)' != ''" />
    <Copy SourceFiles="$(SourceExecutable)" DestinationFiles="$(DestinationExecutable)" />
    <Copy SourceFiles="$(LicensePath)" DestinationFolder="$(Magnetar)" />
    <Copy SourceFiles="$(ReadmePath)" DestinationFolder="$(Magnetar)" />
  </Target>
</Project>
