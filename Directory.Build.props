<Project>
  <!-- Override Project Settings -->
  <PropertyGroup>
    <!-- Folder where Magnetar will be deployed -->
    <Magnetar></Magnetar>

    <!-- Folder containing SpaceEngineersDedicated.exe -->
    <DS64></DS64>

    <!-- Folder containing Steamworks.NET.dll and the steam_api native library.
         On Windows the dedicated server ships both, so this defaults to DS64.
         On Linux the depot carries only the Windows steam_api64.dll, so point
         this at an extracted steam-dependencies.tar.gz from
         github.com/CometWorks/linux-dependencies instead; it holds the pair
         Deploy stages (Steamworks.NET.dll + libsteam_api.so). -->
    <Steamworks></Steamworks>
  </PropertyGroup>

  <!-- Bump the Magnetar version here (centralized) -->
  <PropertyGroup>
    <Version>2.0.0</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
  </PropertyGroup>

  <!-- Local developer overrides for the settings above; ignored by Git (*.user).
       Copy the first PropertyGroup of this file into Directory.Build.props.user
       and fill in your local paths there. -->
  <Import Project="$(MSBuildThisFileDirectory)Directory.Build.props.user"
          Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.props.user')" />

  <!-- Default Project Settings.
       These apply to Magnetar's own projects only. Projects under the Pulsar/
       git submodule use Pulsar's Directory.Build.props; the values they need
       are forwarded on the ProjectReferences in Legacy/Legacy.csproj. -->
  <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
    <Magnetar Condition="'$(Magnetar)' == '' and '$(APPDATA)' != ''">$(APPDATA)\Magnetar</Magnetar>
    <DS64 Condition="'$(DS64)' == ''">$(registry:HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\Steam App 298740@InstallLocation)\DedicatedServer64</DS64>
    <DS64 Condition="'$(DS64)' == '\DedicatedServer64'">C:\Program Files (x86)\Steam\steamapps\common\SpaceEngineersDedicatedServer\DedicatedServer64</DS64>
  </PropertyGroup>

  <PropertyGroup Condition="'$(OS)' != 'Windows_NT'">
    <Magnetar Condition="'$(Magnetar)' == '' and '$(XDG_DATA_HOME)' != ''">$(XDG_DATA_HOME)/Magnetar</Magnetar>
    <Magnetar Condition="'$(Magnetar)' == '' and '$(HOME)' != ''">$(HOME)/.local/share/Magnetar</Magnetar>
    <DS64 Condition="'$(DS64)' == '' and '$(HOME)' != ''">$(HOME)/.steam/steam/steamapps/common/SpaceEngineersDedicatedServer/DedicatedServer64</DS64>
  </PropertyGroup>

  <PropertyGroup>
    <Steamworks Condition="'$(Steamworks)' == ''">$(DS64)</Steamworks>
  </PropertyGroup>

  <!-- Name of the Steam native library inside $(Steamworks), the counterpart
       of Pulsar's property of the same name. Deploy stages it on Linux only;
       see the Steamworks comment above and Legacy.csproj. -->
  <PropertyGroup>
    <SteamApiFileName Condition="'$(OS)' == 'Windows_NT'">steam_api64.dll</SteamApiFileName>
    <SteamApiFileName Condition="'$(OS)' != 'Windows_NT'">libsteam_api.so</SteamApiFileName>
  </PropertyGroup>
</Project>
